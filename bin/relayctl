def cmd_site_list(args, cfg):
    sites = cfg.get("sites", {})
    if getattr(args, "json", False):
        print(json.dumps(
            {name: rconfig.strip_internal(s) for name, s in sites.items()},
            ensure_ascii=False, indent=2))
        return EXIT_OK
    headers = ["站点名称", "状态", "适配器", "面板", "Base URL", "标签"]
    rows = []
    for name, s_cfg in sites.items():
        rows.append([
            name,
            s_cfg.get("status", "parked"),
            s_cfg.get("adapter", "newapi"),
            s_cfg.get("panel", ""),
            s_cfg.get("base", ""),
            ",".join(s_cfg.get("tags") or []),
        ])
    print_table(headers, rows)
    return EXIT_OK


def cmd_site_show(args, cfg):
    s_cfg = _site(cfg, args.site)
    if getattr(args, "json", False):
        print(json.dumps(rconfig.strip_internal(s_cfg), ensure_ascii=False, indent=2))
    else:
        print(rconfig.dump_site_yaml(s_cfg).rstrip())
    return EXIT_OK


def _load_json_arg(raw: str, what: str) -> dict:
    candidate = raw.strip()
    if not candidate:
        return {}
    if os.path.exists(candidate):
        with open(candidate, "r", encoding="utf-8") as f:
            candidate = f.read()
    try:
        data = json.loads(candidate)
    except ValueError as e:
        raise ConfigError(f"{what} 不是合法 JSON: {e}")
    if not isinstance(data, dict):
        raise ConfigError(f"{what} 必须是 JSON 对象")
    return data


def _docs_from_args(args, base: Optional[dict] = None) -> dict:
    docs = dict(base or {})
    for field, value in (
        ("login_method", getattr(args, "login_method", None)),
        ("token_howto", getattr(args, "token_howto", None)),
        ("script_howto", getattr(args, "script_howto", None)),
        ("notes", getattr(args, "notes", None)),
    ):
        if value is not None:
            docs[field] = value
    return {**rconfig.DEFAULT_DOCS, **{k: v for k, v in docs.items() if k in rconfig.DEFAULT_DOCS}}


def _auth_from_args(args, base: Optional[dict] = None) -> dict:
    auth = dict(base or {})
    for field, value in (
        ("type", getattr(args, "auth_type", None)),
        ("access_token", getattr(args, "token", None)),
        ("access_token_env", getattr(args, "token_env", None)),
        ("user_id", getattr(args, "user_id", None)),
        ("username", getattr(args, "username", None)),
        ("password", getattr(args, "password", None)),
        ("password_env", getattr(args, "password_env", None)),
        ("cookie", getattr(args, "cookie", None)),
    ):
        if value is not None:
            auth[field] = value
    return {**rconfig.DEFAULT_AUTH, **{k: v for k, v in auth.items() if k in rconfig.DEFAULT_AUTH}}


def _tags_from_args(args, data: dict):
    raw = getattr(args, "tags", None)
    if raw is None:
        return
    data["tags"] = [t.strip() for t in str(raw).split(",") if t.strip()]


def cmd_site_add(args, cfg):
    data = _load_json_arg(args.from_json, "--from-json") if args.from_json else {}

    for field, value in (
        ("name", args.name),
        ("base", args.base),
        ("console_url", args.console_url),
        ("panel", args.panel),
        ("adapter", args.adapter),
        ("script", args.script),
        ("proxy", args.proxy),
        ("refresh_interval", args.refresh_interval),
        ("status", args.status),
        ("parked_reason", args.parked_reason),
    ):
        if value is not None:
            data[field] = value

    data["docs"] = _docs_from_args(args, data.get("docs"))
    data["auth"] = _auth_from_args(args, data.get("auth"))
    _tags_from_args(args, data)

    name = data.get("name")
    if not name:
        raise ConfigError("缺少站点名，请用 --name 指定（或在 --from-json 中提供 name）")
    if not data.get("base"):
        raise ConfigError("缺少 base，请用 --base 指定站点 API 地址")

    site = {**rconfig.SITE_DEFAULTS, **data}
    site["name"] = name
    path = rconfig.save_site(name, site)
    print(f"[✓] 站点 {name} 已写入: {path}")
    for w in rconfig.site_warnings(site):
        print(f"    提示: {w}")
    return EXIT_OK


def cmd_site_set(args, cfg):
    s_cfg = _site(cfg, args.site)
    data = dict(s_cfg)

    for field, value in (
        ("base", args.base),
        ("console_url", args.console_url),
        ("panel", args.panel),
        ("adapter", args.adapter),
        ("script", args.script),
        ("proxy", args.proxy),
        ("refresh_interval", args.refresh_interval),
        ("status", args.status),
        ("parked_reason", args.parked_reason),
    ):
        if value is not None:
            data[field] = value

    if args.drop_script:
        data["script"] = None

    data["docs"] = _docs_from_args(args, data.get("docs"))
    data["auth"] = _auth_from_args(args, data.get("auth"))
    _tags_from_args(args, data)

    for item in (args.set or []):
        if "=" not in item:
            raise ConfigError(f"--set 需要 key=value 形式，得到: {item}")
        key, value = item.split("=", 1)
        key = key.strip()
        if key not in rconfig.SITE_FIELDS:
            raise ConfigError(f"不允许设置的字段: {key}（可选 {', '.join(rconfig.SITE_FIELDS)}）")
        if key in ("auth", "docs", "tags"):
            raise ConfigError(f"{key} 请使用专用参数修改")
        data[key] = value

    data["name"] = args.site
    path = rconfig.save_site(args.site, data)
    rcache.invalidate(args.site)
    print(f"[✓] 站点 {args.site} 已更新: {path}")
    return EXIT_OK


def cmd_site_rm(args, cfg):
    if args.site not in cfg.get("sites", {}):
        raise ConfigError(f"站点 {args.site} 未登记")
    if not args.yes:
        raise ConfigError(f"删除配置是破坏性操作。请添加 --yes 确认删除站点 {args.site}")
    deleted = rconfig.delete_site(args.site)
    rcache.invalidate(args.site)
    print(f"[✓] 站点 {args.site} 已成功移除。" if deleted else f"[!] 站点 {args.site} 配置文件不存在。")
    return EXIT_OK


def cmd_site_auth(args, cfg):
    s_cfg = _site(cfg, args.site)
    base_url = s_cfg.get("base", "")
    print(f"[*] 正在为站点 {args.site} ({base_url}) 录入凭据...")
    token = getpass.getpass("请输入长期系统访问令牌 (System Access Token): ").strip()
    if not token:
        raise ConfigError("访问令牌不能为空")

    uid_str = input("请输入该站点的 User ID (UID，纯数字，可留空): ").strip()
    uid = int(uid_str) if uid_str.isdigit() else None

    auth = dict(s_cfg.get("auth") or {})
    auth["access_token"] = token
    auth["user_id"] = uid
    data = dict(s_cfg)
    data["auth"] = {**rconfig.DEFAULT_AUTH, **auth}

    adapter = get_adapter(args.site, data, cfg)
    print("[*] 正在验证凭据有效性...")
    p = adapter.probe()
    if p.get("auth_ok"):
        data["status"] = rconfig.STATUS_ACTIVE
        data["parked_reason"] = ""
        rconfig.save_site(args.site, data)
        rcache.invalidate(args.site)
        print(f"[✓] 鉴权成功！站点 {args.site} 已标记为 active。")
        return EXIT_OK
    raise AuthError(f"鉴权未通过: HTTP {p.get('auth_status')}")


# ---------------------------------------------------------------------------
# 站点脚本 (relayctl script new / test)
# ---------------------------------------------------------------------------
def cmd_script_new(args, cfg):
    s_cfg = _site(cfg, args.site)
    name = paths.safe_site_name(args.site)
    paths.ensure_dir(paths.scripts_dir())
    target = os.path.join(paths.scripts_dir(), f"{name}.py")

    if os.path.exists(target) and not args.force:
        raise ConfigError(f"脚本已存在（--force 覆盖）: {target}")

    docs = dict(s_cfg.get("docs") or rconfig.DEFAULT_DOCS)
    howto = (docs.get("script_howto") or "").strip() or rscript.DEFAULT_SCRIPT_HOWTO
    paths.atomic_write_text(target, rscript.script_template(name, howto),
                            mode=rscript.SCRIPT_FILE_MODE)

    data = dict(s_cfg)
    data["docs"] = {**rconfig.DEFAULT_DOCS, **docs, "script_howto": howto}
    data["adapter"] = "script"
    data["script"] = f"scripts/{name}.py"   # 相对 $RELAYCTL_HOME 保存
    data["name"] = name
    saved = rconfig.save_site(name, data)
    rcache.invalidate(name)

    print(f"[✓] 脚本模板已生成: {target} (0750)")
    print(f"[✓] 站点 {name} 已切换: adapter=script script={data['script']} ({saved})")
    print(f"[*] 补全 TODO 后执行: relayctl script test {name}")
    return EXIT_OK


def _script_status_text(status: str) -> str:
    return {
        rscript.STATUS_OK: "supported",
        rscript.STATUS_UNSUPPORTED: "unsupported",
        rscript.STATUS_AUTH: "failed(auth)",
        rscript.STATUS_TIMEOUT: "failed(timeout)",
        rscript.STATUS_ERROR: "failed",
    }.get(status, "failed")


def cmd_script_test(args, cfg):
    s_cfg = _site(cfg, args.site)
    # 搁置（parked）站点也会被 get_adapter 拦截，因此这里直接按配置判定：
    # adapter=script 就该能体检，否则给出可执行的操作指引。
    if str(s_cfg.get("adapter") or "").strip().lower() != "script":
        raise ConfigError(
            f"站点 {args.site} 的 adapter 不是 script（当前 {s_cfg.get('adapter')}），"
            f"请先执行 relayctl script new {args.site}")
    from relayctl.adapters.script import ScriptAdapter

    adapter = ScriptAdapter(args.site, s_cfg, cfg)

    actions = [args.action] if args.action else list(rscript.ACTIONS)
    outcomes = adapter.test_actions(actions)

    failed = [o for o in outcomes if o.status in (rscript.STATUS_ERROR,
                                                  rscript.STATUS_AUTH,
                                                  rscript.STATUS_TIMEOUT)]
    supported = [o for o in outcomes if o.ok]
    unsupported = [o for o in outcomes if o.status == rscript.STATUS_UNSUPPORTED]
    report = {
        "site": args.site,
        "script": adapter.script_path,
        "timeout": adapter.runner.timeout,
        "ok": not failed,
        "summary": {
            "total": len(outcomes),
            "supported": len(supported),
            "unsupported": len(unsupported),
            "failed": len(failed),
        },
        "actions": [o.as_dict() for o in outcomes],
    }

    if args.json:
        print(json.dumps(report, ensure_ascii=False, indent=2, sort_keys=True))
        return EXIT_OK if not failed else EXIT_FAIL

    print(f"[*] 站点 {args.site} 脚本体检: {adapter.script_path}"
          f"（超时 {adapter.runner.timeout}s）")
    for o in outcomes:
        line = (f"  {o.action:<12} {_script_status_text(o.status):<14}"
                f"退出码={o.exit_code}  {o.elapsed * 1000:.1f}ms")
        print(line)
        if o.data is not None:
            text = json.dumps(o.data, ensure_ascii=False, default=str)
            if len(text) > 200:
                text = text[:200] + "…"
            print(f"      结果: {text}")
        if o.error and not o.ok and o.status != rscript.STATUS_UNSUPPORTED:
            print(f"      错误: {o.error}")
    print(f"汇总: supported={len(supported)} unsupported={len(unsupported)} "
          f"failed={len(failed)}")
    if failed:
        print("[!] 存在失败动作（协议违规或退出码异常）")
        return EXIT_FAIL
    return EXIT_OK


# ---------------------------------------------------------------------------
# 探测公开端点
# ---------------------------------------------------------------------------
def cmd_probe_url(args, cfg):
    result = rprobe.probe_url(args.address)
    if args.json:
        print(json.dumps(result, ensure_ascii=False, indent=2))
        return EXIT_OK
    for line in rprobe.probe_report_lines(result):
        print(line)
    return EXIT_OK


# ---------------------------------------------------------------------------
# 批量导入
# ---------------------------------------------------------------------------
def cmd_import_sites(args, cfg):
    text = importers.read_input(args.file)
    candidates, errors = importers.parse_sites(text, fmt=args.format)
    result = importers.apply_sites_import(
        candidates, dry_run=args.dry_run, cfg=cfg, parse_errors=errors)
    if args.json:
        print(json.dumps(result, ensure_ascii=False, indent=2))
    else:
        for line in importers.sites_report_lines(result):
            print(line)
    return EXIT_FAIL if result["failed"] else EXIT_OK


def cmd_import_keys(args, cfg):
    text = importers.read_input(args.file)
    candidates, errors = importers.parse_keys(text, fmt=args.format)
    result = importers.apply_keys_import(
        candidates, dry_run=args.dry_run, cfg=cfg, parse_errors=errors)
    if args.json:
        print(json.dumps(result, ensure_ascii=False, indent=2))
    else:
        for line in importers.keys_report_lines(result):
            print(line)
    return EXIT_FAIL if result["failed"] else EXIT_OK


# ---------------------------------------------------------------------------
# 分发库 (dist)
# ---------------------------------------------------------------------------
def cmd_dist_list(args, cfg):
    items = rdist.list_keys(tag=args.tag or "", site=args.site or "")
    if args.json:
        print(json.dumps({"count": len(items), "items": items},
                         ensure_ascii=False, indent=2))
        return EXIT_OK
    for line in rdist.list_lines(items):
        print(line)
    return EXIT_OK


def cmd_dist_tag(args, cfg):
    result = rdist.tag_key(args.id, add=args.add or "", remove=args.rm or "",
                           dry_run=args.dry_run)
    if args.json:
        print(json.dumps(result, ensure_ascii=False, indent=2))
        return EXIT_OK
    if not result["changed"]:
        print(f"[-] {args.id} 标签无变化: {','.join(result['after'].get('tags') or []) or '-'}")
        return EXIT_OK
    print(f"[✓] {result['after']['id']}  {result['after']['key_masked']}  "
          f"标签={','.join(result['after'].get('tags') or []) or '-'}"
          f"{'（试运行未写盘）' if args.dry_run else ''}")
    return EXIT_OK


def cmd_dist_assign(args, cfg):
    result = rdist.assign_key(args.id, args.to, note=args.note or "", dry_run=args.dry_run)
    if args.json:
        print(json.dumps(result, ensure_ascii=False, indent=2))
        return EXIT_OK
    if not result["changed"]:
        print(f"[-] {args.id} 归属无变化: {result['after'].get('assigned_to') or '-'}")
        return EXIT_OK
    print(f"[✓] {result['after']['id']}  {result['after']['key_masked']}  "
          f"归属={result['after'].get('assigned_to') or '-'}"
          f"{'（试运行未写盘）' if args.dry_run else ''}")
    return EXIT_OK


def cmd_dist_rm(args, cfg):
    result = rdist.remove_key(args.id, yes=args.yes, dry_run=args.dry_run)
    if args.json:
        print(json.dumps(result, ensure_ascii=False, indent=2))
        return EXIT_OK
    removed = result["removed"]
    print(f"[✓] 已删除 {removed['id']}  {removed['key_masked']}（仅本地登记，不动上游）"
          f"{'（试运行未写盘）' if result['dry_run'] else ''}")
    return EXIT_OK


def cmd_dist_export(args, cfg):
    # newapi 目标里 --site 是「推送到哪个已登记站点」；其它目标里是来源站点过滤
    site_filter = "" if args.target == "newapi" else (args.site or "")
    keys = rdist.select_keys(tag=args.tag or "", site=site_filter)
    result = rdist.export(
        keys, args.target, app=args.app, out=args.out, dry_run=args.dry_run,
        yes=args.yes, reveal=args.reveal, site=args.site, cfg=cfg,
        channel_type=args.channel_type)
    if args.json:
        print(json.dumps(result, ensure_ascii=False, indent=2))
    else:
        for line in rdist.export_lines(result):
            print(line)
    return EXIT_FAIL if result.get("failed") else EXIT_OK


# ---------------------------------------------------------------------------
# 迁移
# ---------------------------------------------------------------------------
def cmd_migrate(args, cfg):
    result = rmigrate.migrate(dry_run=args.dry_run)
    for line in rmigrate.migrate_report(result):
        print(line)
    if result["failed"]:
        return EXIT_FAIL
    if args.dry_run:
        print("（试运行未写盘；去掉 --dry-run 执行实际迁移）")
    return EXIT_OK


# ---------------------------------------------------------------------------
# Schema / doctor / MCP
# ---------------------------------------------------------------------------
def cmd_schema(args, cfg):
    data = rschema.schemas(args.kind)
    print(json.dumps(data, ensure_ascii=False, indent=2, sort_keys=True))
    return EXIT_OK


def cmd_doctor(args, cfg):
    report, exit_code = rdoctor.run(check_connectivity=args.check_connectivity)
    if args.json:
        print(json.dumps(report, ensure_ascii=False, indent=2, sort_keys=True))
    else:
        for line in rdoctor.report_lines(report):
            print(line)
    return exit_code


def cmd_mcp(args, cfg):
    from relayctl.mcp import run_stdio
    return run_stdio(allow_destructive=args.allow_destructive,
                     allow_reveal=args.allow_reveal)


# ---------------------------------------------------------------------------
# Web
# ---------------------------------------------------------------------------
def cmd_web(args, cfg):
    from relayctl.web import run_web
    web_cfg = cfg.get("web") or {}
    host = args.host or web_cfg.get("host") or "127.0.0.1"
    port = args.port or web_cfg.get("port") or 8088
    run_web(host=host, port=port, config_override=cfg)
    return EXIT_OK


# ---------------------------------------------------------------------------
# 后台刷新守护 (relayctl daemon)
# ---------------------------------------------------------------------------
def cmd_daemon(args, cfg):
    from relayctl import scheduler as rsched
    from relayctl.paths import logs_dir

    sched = rsched.Scheduler(cfg)

    if args.once:
        report = sched.run_once()
        if args.json:
            print(json.dumps(report, ensure_ascii=False, indent=2))
        else:
            for line in rsched.daemon_report_lines(report):
                print(line)
        return EXIT_OK if not report["summary"]["failed"] else EXIT_FAIL

    log_path = os.path.join(logs_dir(), rsched.LOG_NAME)
    print(f"[*] relayctl daemon 已启动（日志: {log_path}），按 Ctrl+C 停止。")
    try:
        sched.serve_forever()
    finally:
        sched.stop()
    print("[*] relayctl daemon 已停止。")
    return EXIT_OK


def _add_json_args_recursive(parser, root=True):
    """让每一级命令都接受 --json/--json-raw，参数可放在命令路径的任一级。"""
    default = False if root else argparse.SUPPRESS
    if "--json" not in parser._option_string_actions:
        parser.add_argument("--json", action="store_true", default=default,
                            help="输出 relayctl/v2 JSON 信封")
    elif not root:
        # 子 parser 不得用默认 False 覆盖顶层已经解析到的 --json。
        parser._option_string_actions["--json"].default = argparse.SUPPRESS
    if "--json-raw" not in parser._option_string_actions:
        parser.add_argument("--json-raw", action="store_true", default=default,
                            help="只输出 data（兼容旧版 JSON 消费方）")
    if "--json-envelope" not in parser._option_string_actions:
        parser.add_argument("--json-envelope", action="store_true", default=default,
                            help="强制输出 relayctl/v2 信封（覆盖严格旧 JSON 兼容）")
    for action in parser._actions:
        if isinstance(action, argparse._SubParsersAction):
            for child in action.choices.values():
                _add_json_args_recursive(child, root=False)


def build_parser():
    parser = RelayArgumentParser(
        prog="relayctl",
        description="relayctl: 统一多上游 AI 中转站 Key 与余额管理的轻量级工具 (CLI + Web)")
    parser.add_argument("--version", action="version", version=f"relayctl {__version__}")
    subparsers = parser.add_subparsers(dest="command")

    # balance
    p_bal = subparsers.add_parser("balance", help="查看指定站点的额度详情")
    p_bal.add_argument("site", help="站点名称")
    p_bal.add_argument("--refresh", action="store_true", help="强制从上游重新拉取")
    p_bal.add_argument("--cached", action="store_true", help="只读本地缓存，不发网络请求")

    # status
    p_stat = subparsers.add_parser("status", help="列出所有上游站点状态汇总表")
    p_stat.add_argument("--json", action="store_true", help="输出 JSON 格式")
    p_stat.add_argument("--refresh", action="store_true", help="强制从上游重新拉取")
    p_stat.add_argument("--cached", action="store_true", help="只读本地缓存")

    # probe
    p_probe = subparsers.add_parser("probe", help="探测站点健康度与鉴权有效性")
    p_probe.add_argument("site", help="站点名称，或传 'all'")
    p_probe.add_argument("--refresh", action="store_true", help="强制从上游重新拉取")
    p_probe.add_argument("--cached", action="store_true", help="只读本地缓存，不发网络请求")

    # groups
    p_groups = subparsers.add_parser("groups", help="查看指定站点的可用模型分组")
    p_groups.add_argument("site", help="站点名称")
    p_groups.add_argument("--refresh", action="store_true", help="强制从上游重新拉取")
    p_groups.add_argument("--cached", action="store_true", help="只读本地缓存")

    # keys
    p_keys = subparsers.add_parser("keys", help="查看指定站点的 Key 列表")
    p_keys.add_argument("site", help="站点名称")
    p_keys.add_argument("--refresh", action="store_true", help="强制从上游重新拉取")
    p_keys.add_argument("--cached", action="store_true", help="只读本地缓存")

    # key
    p_key = subparsers.add_parser("key", help="Key 生命周期管理 (add / set / rm)")
    key_subs = p_key.add_subparsers(dest="subcommand")

    p_kadd = key_subs.add_parser("add", help="新建 Key")
    p_kadd.add_argument("site", help="站点名称")
    p_kadd.add_argument("--name", required=True, help="Key 名称")
    p_kadd.add_argument("--group", required=True, help="模型分组 (Group)")
    p_kadd.add_argument("--quota", type=float, help="额度设置")
    p_kadd.add_argument("--unlimited", action="store_true", help="设为无限额度")
    p_kadd.add_argument("--models", help="限制模型 (逗号分隔)")
    p_kadd.add_argument("--dry-run", dest="dry_run", action="store_true", help="试运行预览")

    p_kset = key_subs.add_parser("set", help="修改 Key")
    p_kset.add_argument("site", help="站点名称")
    p_kset.add_argument("id", type=int, help="Key ID")
    p_kset.add_argument("--group", help="修改分组")
    p_kset.add_argument("--enable", action="store_true", help="启用 Key")
    p_kset.add_argument("--disable", action="store_true", help="禁用 Key")
    p_kset.add_argument("--quota", type=float, help="修改额度")
    p_kset.add_argument("--unlimited", action="store_true", help="改为无限额度")
    p_kset.add_argument("--dry-run", dest="dry_run", action="store_true", help="试运行预览")

    p_krm = key_subs.add_parser("rm", help="删除 Key")
    p_krm.add_argument("site", help="站点名称")
    p_krm.add_argument("id", type=int, help="Key ID")
    p_krm.add_argument("--yes", action="store_true", help="确认删除 (破坏性操作)")

    # site
    p_site = subparsers.add_parser("site", help="站点配置管理 (add / show / list / set / rm / auth)")
    site_subs = p_site.add_subparsers(dest="subcommand")

    p_slist = site_subs.add_parser("list", help="列出所有配置的站点")
    p_slist.add_argument("--json", action="store_true", help="输出 JSON 格式")

    p_sshow = site_subs.add_parser("show", help="查看单个站点配置（凭据脱敏）")
    p_sshow.add_argument("site", help="站点名称")
    p_sshow.add_argument("--json", action="store_true", help="输出 JSON 格式")

    p_sadd = site_subs.add_parser("add", help="新增站点（非交互，写出完整 docs）")
    _add_site_args(p_sadd)

    p_sset = site_subs.add_parser("set", help="修改站点配置")
    p_sset.add_argument("site", help="站点名称")
    _add_site_args(p_sset)
    p_sset.add_argument("--set", action="append", metavar="KEY=VALUE",
                        help="直接设置顶层字段（如 --set proxy=none）")
    p_sset.add_argument("--drop-script", action="store_true", help="清除脚本配置")

    p_srm = site_subs.add_parser("rm", help="删除站点配置")
    p_srm.add_argument("site", help="站点名称")
    p_srm.add_argument("--yes", action="store_true", help="确认删除")

    p_sauth = site_subs.add_parser("auth", help="交互式录入长期系统访问令牌")
    p_sauth.add_argument("site", help="站点名称")

    # script
    p_script = subparsers.add_parser("script", help="站点脚本管理 (new / test)")
    script_subs = p_script.add_subparsers(dest="subcommand")

    p_snew = script_subs.add_parser("new", help="生成站点脚本模板并切换为 script 适配器")
    p_snew.add_argument("site", help="站点名称")
    p_snew.add_argument("--force", action="store_true", help="覆盖已存在的脚本")

    p_stest = script_subs.add_parser("test", help="逐个动作体检站点脚本")
    p_stest.add_argument("site", help="站点名称")
    p_stest.add_argument("--action", choices=list(rscript.ACTIONS),
                         help="只测试指定动作（默认全部）")
    p_stest.add_argument("--json", action="store_true", help="输出 JSON 格式")

    # probe-url
    p_purl = subparsers.add_parser("probe-url", help="只探测公开端点识别面板（不鉴权、不请求定价）")
    p_purl.add_argument("address", help="站点地址 (http(s)://... 或 域名)")
    p_purl.add_argument("--json", action="store_true", help="输出 JSON 格式")

    # import
    p_import = subparsers.add_parser("import", help="批量导入 (sites / keys)")
    imp_subs = p_import.add_subparsers(dest="subcommand")

    p_isites = imp_subs.add_parser("sites", help="批量导入站点（文件 或 - 表示 stdin）")
    p_isites.add_argument("file", help="导入文件路径，- 表示标准输入")
    p_isites.add_argument("--dry-run", dest="dry_run", action="store_true",
                          help="只探测与预览，绝不写盘")
    p_isites.add_argument("--json", action="store_true", help="输出 JSON 格式（绝不含明文令牌）")
    p_isites.add_argument("--format", dest="format", default="auto",
                          choices=list(importers.SITE_FORMATS), help="导入格式（默认 auto）")

    p_ikeys = imp_subs.add_parser("keys", help="批量导入分发 Key（文件 或 - 表示 stdin）")
    p_ikeys.add_argument("file", help="导入文件路径，- 表示标准输入")
    p_ikeys.add_argument("--dry-run", dest="dry_run", action="store_true", help="只预览，绝不写盘")
    p_ikeys.add_argument("--json", action="store_true", help="输出 JSON 格式（只含脱敏 Key）")
    p_ikeys.add_argument("--format", dest="format", default="auto",
                         choices=list(importers.KEY_FORMATS), help="导入格式（默认 auto）")

    # dist
    p_dist = subparsers.add_parser("dist", help="分发库管理 (list / tag / assign / rm / export)")
    dist_subs = p_dist.add_subparsers(dest="subcommand")

    p_dlist = dist_subs.add_parser("list", help="列出分发 Key（默认只显示 id 与脱敏 Key）")
    p_dlist.add_argument("--tag", help="按标签过滤")
    p_dlist.add_argument("--site", help="按来源站点过滤")
    p_dlist.add_argument("--json", action="store_true", help="输出 JSON 格式")

    p_dtag = dist_subs.add_parser("tag", help="增删分发 Key 的标签")
    p_dtag.add_argument("id", help="Key 指纹 id（可写唯一前缀）")
    p_dtag.add_argument("--add", help="新增标签（逗号分隔）")
    p_dtag.add_argument("--rm", help="移除标签（逗号分隔）")
    p_dtag.add_argument("--dry-run", dest="dry_run", action="store_true", help="只预览不写盘")
    p_dtag.add_argument("--json", action="store_true", help="输出 JSON 格式")

    p_dassign = dist_subs.add_parser("assign", help="记录 Key 归属（谁 / 哪个客户端）")
    p_dassign.add_argument("id", help="Key 指纹 id（可写唯一前缀）")
    p_dassign.add_argument("--to", required=True, help="归属对象（人 / 客户端）")
    p_dassign.add_argument("--note", help="备注")
    p_dassign.add_argument("--dry-run", dest="dry_run", action="store_true", help="只预览不写盘")
    p_dassign.add_argument("--json", action="store_true", help="输出 JSON 格式")

    p_drm = dist_subs.add_parser("rm", help="从分发库删除一条登记（不动上游）")
    p_drm.add_argument("id", help="Key 指纹 id（可写唯一前缀）")
    p_drm.add_argument("--yes", action="store_true", help="确认删除（破坏性操作）")
    p_drm.add_argument("--dry-run", dest="dry_run", action="store_true", help="只预览不写盘")
    p_drm.add_argument("--json", action="store_true", help="输出 JSON 格式")

    p_dexp = dist_subs.add_parser("export", help="导出分发 Key")
    p_dexp.add_argument("--target", required=True, choices=list(rdist.EXPORT_TARGETS),
                        help="导出目标: ccswitch / newapi / env / json / csv")
    p_dexp.add_argument("--tag", help="只导出带该标签的 Key")
    p_dexp.add_argument("--app", default="all", choices=list(rexporters.CCSWITCH_APP_CHOICES),
                        help="ccswitch 目标的应用（默认 all）")
    p_dexp.add_argument("--site", help="newapi: 推送到哪个已登记站点；其它: 按来源站点过滤")
    p_dexp.add_argument("--channel-type", dest="channel_type",
                        default=str(rexporters.DEFAULT_CHANNEL_TYPE),
                        help="newapi 渠道 type（1 openai / 14 anthropic / 24 gemini / 57 codex）")
    p_dexp.add_argument("--out", help="导出文件路径（0600；不写 stdout）")
    p_dexp.add_argument("--dry-run", dest="dry_run", action="store_true",
                        help="只预览，绝不写盘 / 绝不写上游")
    p_dexp.add_argument("--yes", action="store_true",
                        help="newapi 实际写入的确认（默认试运行）")
    p_dexp.add_argument("--reveal", action="store_true",
                        help="显式要求把明文 Key 打到 stdout（默认只显示脱敏）")
    p_dexp.add_argument("--json", action="store_true", help="输出 JSON 格式")

    # migrate
    p_mig = subparsers.add_parser("migrate", help="把旧 sites.yaml 迁移为 sites/<name>.yaml")
    p_mig.add_argument("--dry-run", dest="dry_run", action="store_true", help="只预览不写盘")

    # schema
    p_schema = subparsers.add_parser("schema", help="输出配置与脚本协议 JSON Schema")
    p_schema.add_argument("--kind", choices=["site", "script", "dist", "all"], default="all",
                          help="选择 schema 类型（默认 all）")

    # doctor
    p_doctor = subparsers.add_parser("doctor", help="检查配置、权限、凭据引用与本地缓存")
    p_doctor.add_argument("--check-connectivity", action="store_true",
                          help="显式执行站点网络连通性检查（默认绝不联网）")

    # MCP stdio
    p_mcp = subparsers.add_parser("mcp", help="启动 stdio JSON-RPC MCP 服务")
    p_mcp.add_argument("--allow-destructive", action="store_true",
                       help="注册删除类工具")
    p_mcp.add_argument("--allow-reveal", action="store_true",
                       help="注册允许明文导出的工具")

    # web
    p_web = subparsers.add_parser("web", help="启动双端自适应 Web 管理控制台")
    p_web.add_argument("--host", default=None, help="监听地址 (默认 127.0.0.1)")
    p_web.add_argument("--port", type=int, default=None, help="监听端口 (默认 8088)")

    # daemon
    p_daemon = subparsers.add_parser("daemon", help="后台定时刷新站点缓存 (systemd user 常驻)")
    p_daemon.add_argument("--once", action="store_true", help="只刷新当前到期的站点后退出")
    p_daemon.add_argument("--json", action="store_true", help="输出 JSON 格式")

    # 顶层 parser 上挂一份子命令 parser 映射（未知子命令时打印对应帮助）
    parser.help_parsers = {"key": p_key, "site": p_site, "import": p_import,
                           "script": p_script, "dist": p_dist}
    _add_json_args_recursive(parser)
    return parser, p_key, p_site, p_import


def _add_site_args(parser):
    # --name 不设为 argparse required：--from-json 也可以提供 name，统一在函数内校验
    parser.add_argument("--name", help="站点名称")
    parser.add_argument("--base", help="站点 API 地址 (http(s)://...)")
    parser.add_argument("--console-url", dest="console_url", help="站点控制台地址")
    parser.add_argument("--panel", choices=["newapi", "oneapi", "custom"],
                        help="面板类型 (newapi / oneapi / custom)")
    parser.add_argument("--adapter", choices=["newapi", "oneapi", "script"],
                        help="适配器标识 (newapi / oneapi / script)")
    parser.add_argument("--script", help="adapter=script 时的脚本路径")
    parser.add_argument("--auth-type", dest="auth_type",
                        choices=["access_token", "cookie", "password", "none"],
                        help="鉴权类型 (access_token/cookie/password/none)")
    parser.add_argument("--token", help="访问令牌（明文，优先推荐 --token-env）")
    parser.add_argument("--token-env", dest="token_env", help="从环境变量读取令牌（明文不落盘）")
    parser.add_argument("--user-id", dest="user_id", type=int, help="User ID (UID)")
    parser.add_argument("--username", help="密码登录用户名")
    parser.add_argument("--password", help="密码登录密码（明文，优先推荐 --password-env）")
    parser.add_argument("--password-env", dest="password_env", help="从环境变量读取密码")
    parser.add_argument("--cookie", help="Cookie 登录态（明文）")
    parser.add_argument("--login-method", dest="login_method", help="docs: 登录/进站方式")
    parser.add_argument("--token-howto", dest="token_howto", help="docs: 长期令牌获取路径")
    parser.add_argument("--script-howto", dest="script_howto", help="docs: 脚本使用说明")
    parser.add_argument("--notes", help="docs: 排障备注")
    parser.add_argument("--proxy", help="代理策略: none / auto / http://host:port")
    parser.add_argument("--refresh-interval", dest="refresh_interval", help="刷新间隔 (如 30m)")
    parser.add_argument("--tags", help="标签（逗号分隔）")
    parser.add_argument("--status", choices=[rconfig.STATUS_ACTIVE, rconfig.STATUS_PARKED],
                        help="站点状态")
    parser.add_argument("--parked-reason", dest="parked_reason", help="搁置原因")
    parser.add_argument("--from-json", dest="from_json",
                        help="从 JSON 字符串或 JSON 文件读取站点配置")


def _command_name(args) -> str:
    parts = [getattr(args, "command", None), getattr(args, "subcommand", None)]
    return " ".join(str(part) for part in parts if part)


_RAW_SECRET_RE = re.compile(r"sk-[A-Za-z0-9_\-]{12,}")


def _redact_strings(value):
    if isinstance(value, dict):
        return {key: _redact_strings(item) for key, item in value.items()}
    if isinstance(value, list):
        return [_redact_strings(item) for item in value]
    if isinstance(value, tuple):
        return [_redact_strings(item) for item in value]
    if isinstance(value, str):
        # 已经是脱敏形态（key_masked 的 `前4...后4`）就不再二次遮盖，
        # 否则 JSON 消费方拿不到可用于人工比对的脱敏值。
        if "..." in value and not _RAW_SECRET_RE.search(value):
            return value
        return rcache.redact_text(value)
    return value


def _data_from_output(text: str, command: str, allow_reveal: bool = False):
    output = text.strip()
    if not output:
        data = None
    else:
        try:
            data = json.loads(output)
        except ValueError:
            data = {"text": output}
    # schema 的 properties 名称本身包含 access_token/key，不能按凭据字段删除。
    if command != "schema":
        data = rmodels.sanitize(data)
    if not allow_reveal:
        data = _redact_strings(data)
    return data


def _json_envelope(command: str, data, exit_code: int, warnings=None, message: str = "") -> dict:
    envelope = {
        "schema": "relayctl/v2",
        "ok": exit_code == EXIT_OK,
        "command": command,
        "data": data,
        "meta": {"exit_code": exit_code, "version": __version__},
        "warnings": list(warnings or []),
        "error": None if exit_code == EXIT_OK else {
            "code": exit_code,
            "message": rcache.redact_text(message or f"命令返回退出码 {exit_code}"),
        },
    }
    # 阶段 6 统一以 data 为规范契约；为不破坏 v2 之前已发布且直接读取顶层字段的
    # 自动化，仅对过去已经支持 --json 的命令提供同名只读兼容别名。新调用方应只
    # 读取 envelope["data"]；--json-raw 则提供无信封的稳定迁移出口。信封保留字段
    # 永远不会被别名覆盖，新命令保持严格的七字段信封，不产生重复数据。
    legacy_json_commands = {
        "status", "site list", "site show", "script test", "probe-url",
        "import sites", "import keys", "dist list", "dist tag", "dist assign",
        "dist rm", "dist export", "daemon",
    }
    if command in legacy_json_commands and isinstance(data, dict):
        for key, value in data.items():
            # 信封保留字段永不被别名覆盖：data 才是规范契约，
            # probe-url 等命令的 ok/error 一律读 envelope["data"]。
            if key not in envelope:
                envelope[key] = value
    return envelope


def _dispatch(args, cfg, parser, p_key, p_site, p_import):
    handlers = {
        "balance": cmd_balance,
        "status": cmd_status,
        "probe": cmd_probe,
        "probe-url": cmd_probe_url,
        "groups": cmd_groups,
        "keys": cmd_keys,
        "migrate": cmd_migrate,
        "schema": cmd_schema,
        "doctor": cmd_doctor,
        "web": cmd_web,
        "daemon": cmd_daemon,
    }
    if args.command in handlers:
        return handlers[args.command](args, cfg)
    if args.command == "key":
        if args.subcommand == "add":
            return cmd_key_add(args, cfg)
        if args.subcommand == "set":
            return cmd_key_set(args, cfg)
        if args.subcommand == "rm":
            return cmd_key_rm(args, cfg)
        p_key.print_help()
        return EXIT_USAGE
    if args.command == "site":
        if args.subcommand == "list":
            return cmd_site_list(args, cfg)
        if args.subcommand == "show":
            return cmd_site_show(args, cfg)
        if args.subcommand == "add":
            return cmd_site_add(args, cfg)
        if args.subcommand == "set":
            return cmd_site_set(args, cfg)
        if args.subcommand == "rm":
            return cmd_site_rm(args, cfg)
        if args.subcommand == "auth":
            return cmd_site_auth(args, cfg)
        p_site.print_help()
        return EXIT_USAGE
    if args.command == "script":
        if args.subcommand == "new":
            return cmd_script_new(args, cfg)
        if args.subcommand == "test":
            return cmd_script_test(args, cfg)
        parser.help_parsers["script"].print_help()
        return EXIT_USAGE
    if args.command == "import":
        if args.subcommand == "sites":
            return cmd_import_sites(args, cfg)
        if args.subcommand == "keys":
            return cmd_import_keys(args, cfg)
        p_import.print_help()
        return EXIT_USAGE
    if args.command == "dist":
        if args.subcommand == "list":
            return cmd_dist_list(args, cfg)
        if args.subcommand == "tag":
            return cmd_dist_tag(args, cfg)
        if args.subcommand == "assign":
            return cmd_dist_assign(args, cfg)
        if args.subcommand == "rm":
            return cmd_dist_rm(args, cfg)
        if args.subcommand == "export":
            return cmd_dist_export(args, cfg)
        parser.help_parsers["dist"].print_help()
        return EXIT_USAGE
    parser.print_help()
    return EXIT_USAGE


def main(argv=None):
    raw_argv = list(sys.argv[1:] if argv is None else argv)
    json_requested = any(flag in raw_argv for flag in ("--json", "--json-raw", "--json-envelope"))
    parser, p_key, p_site, p_import = build_parser()
    try:
        args = parser.parse_args(raw_argv)
    except UsageError as exc:
        if json_requested:
            command = next((part for part in raw_argv if not part.startswith("-")), "")
            print(json.dumps(_json_envelope(command, None, EXIT_USAGE, message=str(exc)),
                             ensure_ascii=False, indent=2, sort_keys=True))
        else:
            print(parser.format_usage().rstrip())
            print(f"[!] 参数问题: {exc}")
        return EXIT_USAGE

    args.json_raw = bool(getattr(args, "json_raw", False))
    args.json_envelope = bool(getattr(args, "json_envelope", False))
    args.json = bool(getattr(args, "json", False) or args.json_raw or args.json_envelope)
    if not args.command:
        parser.print_help()
        return EXIT_OK

    # MCP 的 stdout 专用于 JSON-RPC 帧，绝不能经过普通 CLI 信封或输出捕获。
    if args.command == "mcp":
        return cmd_mcp(args, None)

    command = _command_name(args)
    warnings = []
    error_message = ""
    captured = io.StringIO()
    try:
        if args.command in ("schema", "doctor"):
            cfg = None
        else:
            cfg = rconfig.load_config()
            warnings = [f"站点 {item['name']} 配置加载失败: {item['error']}"
                        for item in cfg.get("site_errors", [])]
            if not args.json:
                for warning in warnings:
                    print(f"[!] {warning}", file=sys.stderr)
        with contextlib.redirect_stdout(captured):
            exit_code = _dispatch(args, cfg, parser, p_key, p_site, p_import)
    except AuthError as exc:
        exit_code, error_message = EXIT_AUTH, f"鉴权失败: {exc}"
    except UsageError as exc:
        exit_code, error_message = EXIT_USAGE, f"参数问题: {exc}"
    except NotSupported as exc:
        exit_code, error_message = EXIT_NOTSUPPORTED, str(exc)
    except ConfigError as exc:
        exit_code, error_message = EXIT_USAGE, f"配置错误: {exc}"
    except KeyboardInterrupt:
        exit_code, error_message = EXIT_FAIL, "已中断"
    except Exception as exc:  # CLI 边界统一收敛，客户端不接收堆栈
        exit_code, error_message = EXIT_FAIL, f"操作失败: {exc}"

    if args.json:
        allow_reveal = command == "dist export" and bool(getattr(args, "reveal", False))
        data = _data_from_output(captured.getvalue(), command, allow_reveal=allow_reveal)
        if args.json_raw:
            if error_message and data is None:
                data = {"error": rcache.redact_text(error_message), "code": exit_code}
            print(json.dumps(data, ensure_ascii=False, indent=2, sort_keys=True))
        else:
            print(json.dumps(_json_envelope(command, data, exit_code, warnings, error_message),
                             ensure_ascii=False, indent=2, sort_keys=True))
    else:
        sys.stdout.write(captured.getvalue())
        if error_message:
            print(f"[!] {rcache.redact_text(error_message)}")
    return exit_code


if __name__ == "__main__":
    sys.exit(main())
