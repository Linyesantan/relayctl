#!/usr/bin/env python3
"""
relayctl: 统一多上游 AI 中转站 Key 与余额管理的轻量级工具 (CLI + Web)
"""

import sys
import os
import argparse
import json
import getpass
import re
import datetime
from typing import Optional, List, Union

current_dir = os.path.dirname(os.path.realpath(__file__))
parent_dir = os.path.dirname(current_dir)
if parent_dir not in sys.path:
    sys.path.insert(0, parent_dir)

from relayctl.core import load_config, save_config, print_table, mask_key, HttpClient, AuthError
from relayctl.adapters import get_adapter
from relayctl.adapters.base import ParkedAdapter, NotSupported
from relayctl import cache as rcache

# 退出码
EXIT_OK = 0             # 成功
EXIT_FAIL = 1           # 一般失败
EXIT_AUTH = 2           # 鉴权失败（401 / AUTH_*）
EXIT_NOTSUPPORTED = 3   # 站点或适配器不支持该操作
EXIT_USAGE = 4          # 参数或配置问题

def cache_note(meta) -> str:
    """标注数据的最新更新时间。"""
    if not meta:
        return ""
    if meta.get("from_cache"):
        return f"最新更新时间: {meta.get('fetched_at')}（缓存，{rcache.age_text(meta['ts'])}；--refresh 重新拉取）"
    return f"最新更新时间: {meta.get('fetched_at')}（刚刚实时拉取）"

def cmd_balance(args, cfg):
    name = args.site
    sites = cfg.get("sites", {})
    s_cfg = sites.get(name)
    if not s_cfg:
        print(f"[!] 站点 {name} 未登记")
        return EXIT_USAGE
    adapter = get_adapter(name, s_cfg, cfg)
    try:
        b, meta = rcache.fetch(name, "balance", adapter.balance, rcache.mode_from_args(args))
        print(f"--- 站点 {name} 余额详情 ---")
        print(cache_note(meta))
        print(f"当前额度: {b.get('balance')} (原始配额: {b.get('raw_quota')})")
        print(f"已用额度: {b.get('used')} (原始用量: {b.get('raw_used')})")
        print(f"配额底数: {b.get('quota_per_unit', 500000)}")
        print(f"站点标注: {b.get('display_type', 'USD')} (仅供参考，不作换算)")
        print(f"用户分组: {b.get('user_group')}")
        return EXIT_OK
    except AuthError as ae:
        print(f"[!] 鉴权失败: {ae}")
        return EXIT_AUTH
    except NotSupported as ns:
        print(f"[!] {ns}")
        return EXIT_NOTSUPPORTED
    except Exception as e:
        print(f"[!] 获取余额失败: {e}")
        return EXIT_FAIL

def cmd_status(args, cfg):
    sites = cfg.get("sites", {})
    c_mode = rcache.mode_from_args(args)
    
    if args.json:
        result = {}
        for name, s_cfg in sites.items():
            adapter = get_adapter(name, s_cfg, cfg)
            tier = s_cfg.get("tier", "parked")
            if tier == "parked":
                result[name] = {
                    "tier": "parked",
                    "reason": s_cfg.get("parked_reason")
                }
            else:
                try:
                    b, b_meta = rcache.fetch(name, "balance", adapter.balance, c_mode)
                    key_count = None
                    keys_error = None
                    try:
                        keys, _ = rcache.fetch(name, "keys", adapter.list_keys, c_mode)
                        key_count = len(keys)
                    except Exception as e:
                        keys_error = str(e)
                    result[name] = {
                        "tier": tier,
                        "balance": b.get("balance"),
                        "used": b.get("used"),
                        "quota_per_unit": b.get("quota_per_unit"),
                        "display_type": b.get("display_type"),
                        "group": b.get("user_group"),
                        "key_count": key_count,
                        "keys_error": keys_error,
                        "from_cache": b_meta["from_cache"]
                    }
                except AuthError as ae:
                    result[name] = {"tier": tier, "error": f"鉴权失败: {ae}"}
                except Exception as e:
                    result[name] = {"tier": tier, "error": str(e)}
        print(json.dumps(result, ensure_ascii=False, indent=2))
        return EXIT_OK

    headers = ["站点", "级别", "余额 / 配额", "已用", "用户分组", "Key数", "站点标注", "状态 / 诊断详情"]
    rows = []

    for name, s_cfg in sites.items():
        adapter = get_adapter(name, s_cfg, cfg)
        tier = s_cfg.get("tier", "parked")

        if tier == "parked":
            rows.append([
                name, tier, "-", "-", "-", "-", "-",
                s_cfg.get("parked_reason") or "缺少凭据"
            ])
        else:
            try:
                b, _ = rcache.fetch(name, "balance", adapter.balance, c_mode)
                bal = str(b.get("balance", "-"))
                used = str(b.get("used", "-"))
                group = b.get("user_group", "-")
                display_type = b.get("display_type", "")
                
                try:
                    keys, _ = rcache.fetch(name, "keys", adapter.list_keys, c_mode)
                    k_count = str(len(keys))
                except Exception:
                    k_count = "获取失败"

                rows.append([name, tier, bal, used, group, k_count, display_type, "正常活跃"])
            except AuthError as ae:
                rows.append([name, tier, "-", "-", "-", "-", "-", f"鉴权失效 ({ae})"])
            except NotSupported as ns:
                rows.append([name, tier, "-", "-", "-", "-", "-", str(ns)])
            except Exception as e:
                rows.append([name, tier, "-", "-", "-", "-", "-", f"异常: {e}"])

    print_table(headers, rows)
    return EXIT_OK

def cmd_groups(args, cfg):
    name = args.site
    sites = cfg.get("sites", {})
    s_cfg = sites.get(name)
    if not s_cfg:
        print(f"[!] 站点 {name} 未登记")
        return EXIT_USAGE
    adapter = get_adapter(name, s_cfg, cfg)
    try:
        g_list, meta = rcache.fetch(name, "groups", adapter.groups, rcache.mode_from_args(args))
        if meta.get("from_cache"):
            print(cache_note(meta))
        headers = ["分组名称", "说明", "倍率"]
        rows = []
        for g in g_list:
            rows.append([g.get("name", ""), g.get("desc", ""), str(g.get("ratio", ""))])
        print_table(headers, rows)
        return EXIT_OK
    except AuthError as ae:
        print(f"[!] 鉴权失败: {ae}")
        return EXIT_AUTH
    except NotSupported as ns:
        print(f"[!] {ns}")
        return EXIT_NOTSUPPORTED
    except Exception as e:
        print(f"[!] 获取分组失败: {e}")
        return EXIT_FAIL

def cmd_keys(args, cfg):
    name = args.site
    sites = cfg.get("sites", {})
    s_cfg = sites.get(name)
    if not s_cfg:
        print(f"[!] 站点 {name} 未登记")
        return EXIT_USAGE
    adapter = get_adapter(name, s_cfg, cfg)
    try:
        k_list, meta = rcache.fetch(name, "keys", adapter.list_keys, rcache.mode_from_args(args))
        if meta.get("from_cache"):
            print(cache_note(meta))
        headers = ["ID", "名称", "分组", "状态", "剩余额度", "已用额度", "Key (脱敏)"]
        rows = []
        for k in k_list:
            rows.append([
                str(k.get("id", "")),
                k.get("name", ""),
                k.get("group", ""),
                "启用" if k.get("status") == 1 else "禁用",
                str(k.get("remain_quota", "")),
                str(k.get("used_quota", "")),
                k.get("key", "")
            ])
        print_table(headers, rows)
        return EXIT_OK
    except AuthError as ae:
        print(f"[!] 鉴权失败: {ae}")
        return EXIT_AUTH
    except NotSupported as ns:
        print(f"[!] {ns}")
        return EXIT_NOTSUPPORTED
    except Exception as e:
        print(f"[!] 获取 Key 列表失败: {e}")
        return EXIT_FAIL

def cmd_key_add(args, cfg):
    name = args.site
    sites = cfg.get("sites", {})
    s_cfg = sites.get(name)
    if not s_cfg:
        print(f"[!] 站点 {name} 未登记")
        return EXIT_USAGE

    if not args.unlimited and args.quota is None:
        print("[!] 必须指定 --quota <额度> 或 --unlimited 之一")
        return EXIT_USAGE
    if args.quota is not None and args.quota <= 0:
        print(f"[!] 额度必须为大于 0 的数值，得到: {args.quota}")
        return EXIT_USAGE

    if args.dry_run:
        quota_desc = "无限" if args.unlimited else str(args.quota)
        print(f"[试运行] 将在站点 {name} 创建 Key:")
        print(f"  名称: {args.name}")
        print(f"  分组: {args.group}")
        print(f"  额度: {quota_desc}")
        return EXIT_OK

    adapter = get_adapter(name, s_cfg, cfg)
    try:
        res = adapter.create_key(
            name=args.name,
            group=args.group,
            quota=args.quota,
            unlimited=args.unlimited,
            models=args.models.split(",") if args.models else None
        )
        rcache.invalidate(name, ["keys"])
        print(f"[✓] Key 创建成功！ID: {res.get('id')}，脱敏: {res.get('key_masked')}")
        return EXIT_OK
    except Exception as e:
        print(f"[!] 创建 Key 失败: {e}")
        return EXIT_FAIL

def cmd_key_set(args, cfg):
    name = args.site
    sites = cfg.get("sites", {})
    s_cfg = sites.get(name)
    if not s_cfg:
        print(f"[!] 站点 {name} 未登记")
        return EXIT_USAGE

    if args.enable and args.disable:
        print("[!] --enable 和 --disable 互斥，不能同时使用")
        return EXIT_USAGE
    if args.unlimited and args.quota is not None:
        print("[!] --quota 和 --unlimited 互斥，不能同时使用")
        return EXIT_USAGE
    if args.quota is not None and args.quota <= 0:
        print(f"[!] 额度必须为大于 0 的数值，得到: {args.quota}")
        return EXIT_USAGE

    status = None
    if args.enable:
        status = 1
    elif args.disable:
        status = 2

    if args.dry_run:
        print(f"[试运行] 将修改站点 {name} 的 Key ID: {args.id}")
        if status: print(f"  状态: {'启用' if status == 1 else '禁用'}")
        if args.group: print(f"  分组: {args.group}")
        return EXIT_OK

    adapter = get_adapter(name, s_cfg, cfg)
    try:
        res = adapter.update_key(
            key_id=args.id,
            status=status,
            group=args.group,
            quota=args.quota,
            unlimited=args.unlimited
        )
        rcache.invalidate(name, ["keys"])
        print(f"[✓] Key {args.id} 更新成功！")
        return EXIT_OK
    except Exception as e:
        print(f"[!] 修改 Key 失败: {e}")
        return EXIT_FAIL

def cmd_key_rm(args, cfg):
    name = args.site
    sites = cfg.get("sites", {})
    s_cfg = sites.get(name)
    if not s_cfg:
        print(f"[!] 站点 {name} 未登记")
        return EXIT_USAGE

    if not args.yes:
        print(f"[!] 删除 Key 是破坏性操作。请添加 --yes 参数以确认删除 Key ID: {args.id}")
        return EXIT_USAGE

    adapter = get_adapter(name, s_cfg, cfg)
    try:
        adapter.delete_key(key_id=args.id)
        rcache.invalidate(name, ["keys"])
        print(f"[✓] 站点 {name} 的 Key ID: {args.id} 已成功删除。")
        return EXIT_OK
    except Exception as e:
        print(f"[!] 删除 Key 失败: {e}")
        return EXIT_FAIL

def cmd_probe(args, cfg):
    target = args.site
    sites = cfg.get("sites", {})
    
    if target == "all":
        check_list = list(sites.keys())
    else:
        if target not in sites:
            print(f"[!] 站点 {target} 未登记")
            return EXIT_USAGE
        check_list = [target]

    headers = ["站点", "识别系统", "版本", "鉴权状态", "配额底数", "计费币种"]
    rows = []

    for name in check_list:
        s_cfg = sites[name]
        adapter = get_adapter(name, s_cfg, cfg)
        try:
            p = adapter.probe()
            auth_str = "有效" if p.get("auth_ok") else f"失效 ({p.get('auth_status')})"
            rows.append([
                name,
                p.get("system_name", "未知"),
                p.get("version", "未知"),
                auth_str,
                str(p.get("quota_per_unit", "-")),
                p.get("quota_display_type", "-")
            ])
        except Exception as e:
            rows.append([name, "探测异常", "-", str(e), "-", "-"])

    print_table(headers, rows)
    return EXIT_OK

def cmd_site_list(args, cfg):
    sites = cfg.get("sites", {})
    headers = ["站点名称", "级别 (Tier)", "适配器 (Adapter)", "Base URL"]
    rows = []
    for name, s_cfg in sites.items():
        rows.append([
            name,
            s_cfg.get("tier", "parked"),
            s_cfg.get("adapter", "newapi"),
            s_cfg.get("base", "")
        ])
    print_table(headers, rows)
    return EXIT_OK

def cmd_site_auth(args, cfg):
    name = args.site
    sites = cfg.get("sites", {})
    s_cfg = sites.get(name)
    if not s_cfg:
        print(f"[!] 站点 {name} 未在 sites.yaml 登记")
        return EXIT_USAGE

    base_url = s_cfg.get("base", "")
    print(f"[*] 正在为站点 {name} ({base_url}) 录入凭据...")
    token = getpass.getpass("请输入长期系统访问令牌 (System Access Token): ").strip()
    if not token:
        print("[!] 访问令牌不能为空")
        return EXIT_USAGE

    uid_str = input("请输入该站点的 User ID (UID，纯数字，可留空): ").strip()
    uid = int(uid_str) if uid_str.isdigit() else None

    s_cfg.setdefault("auth", {})
    s_cfg["auth"]["access_token"] = token
    s_cfg["auth"]["user_id"] = uid

    adapter = get_adapter(name, s_cfg, cfg)
    print("[*] 正在验证凭据有效性...")
    p = adapter.probe()
    if p.get("auth_ok"):
        s_cfg["tier"] = "api"
        s_cfg["parked_reason"] = None
        save_config(cfg)
        rcache.invalidate(name)
        print(f"[✓] 鉴权成功！站点 {name} 已晋级为 api 级别！")
        return EXIT_OK
    else:
        print(f"[!] 鉴权未通过: HTTP {p.get('auth_status')}")
        return EXIT_AUTH

def cmd_site_rm(args, cfg):
    name = args.site
    sites = cfg.get("sites", {})
    if name not in sites:
        print(f"[!] 站点 {name} 未登记")
        return EXIT_USAGE
    if not args.yes:
        print(f"[!] 删除配置是破坏性操作。请添加 --yes 确认删除站点 {name}")
        return EXIT_USAGE
    del sites[name]
    save_config(cfg)
    rcache.invalidate(name)
    print(f"[✓] 站点 {name} 已成功移除。")
    return EXIT_OK

def main():
    parser = argparse.ArgumentParser(description="relayctl: 统一多上游 AI 中转站 Key 与余额管理的轻量级工具 (CLI + Web)")
    subparsers = parser.add_subparsers(dest="command")

    # balance
    p_bal = subparsers.add_parser("balance", help="查看指定站点的额度详情")
    p_bal.add_argument("site", help="站点名称")
    p_bal.add_argument("--refresh", action="store_true", help="强制从上游重新拉取")

    # status
    p_stat = subparsers.add_parser("status", help="列出所有上游站点状态汇总表")
    p_stat.add_argument("--json", action="store_true", help="输出 JSON 格式")
    p_stat.add_argument("--refresh", action="store_true", help="强制从上游重新拉取")

    # probe
    p_probe = subparsers.add_parser("probe", help="探测站点健康度与鉴权有效性")
    p_probe.add_argument("site", help="站点名称，或传 'all'")

    # groups
    p_groups = subparsers.add_parser("groups", help="查看指定站点的可用模型分组")
    p_groups.add_argument("site", help="站点名称")
    p_groups.add_argument("--refresh", action="store_true", help="强制从上游重新拉取")

    # keys
    p_keys = subparsers.add_parser("keys", help="查看指定站点的 Key 列表")
    p_keys.add_argument("site", help="站点名称")
    p_keys.add_argument("--refresh", action="store_true", help="强制从上游重新拉取")

    # key
    p_key = subparsers.add_parser("key", help="Key 生命周期管理 (add / set / rm)")
    key_subs = p_key.add_subparsers(dest="subcommand")

    # key add
    p_kadd = key_subs.add_parser("add", help="新建 Key")
    p_kadd.add_argument("site", help="站点名称")
    p_kadd.add_argument("--name", required=True, help="Key 名称")
    p_kadd.add_argument("--group", required=True, help="模型分组 (Group)")
    p_kadd.add_argument("--quota", type=float, help="额度设置")
    p_kadd.add_argument("--unlimited", action="store_true", help="设为无限额度")
    p_kadd.add_argument("--models", help="限制模型 (逗号分隔)")
    p_kadd.add_argument("--dry-run", dest="dry_run", action="store_true", help="试运行预览")

    # key set
    p_kset = key_subs.add_parser("set", help="修改 Key")
    p_kset.add_argument("site", help="站点名称")
    p_kset.add_argument("id", type=int, help="Key ID")
    p_kset.add_argument("--group", help="修改分组")
    p_kset.add_argument("--enable", action="store_true", help="启用 Key")
    p_kset.add_argument("--disable", action="store_true", help="禁用 Key")
    p_kset.add_argument("--quota", type=float, help="修改额度")
    p_kset.add_argument("--unlimited", action="store_true", help="改为无限额度")
    p_kset.add_argument("--dry-run", dest="dry_run", action="store_true", help="试运行预览")

    # key rm
    p_krm = key_subs.add_parser("rm", help="删除 Key")
    p_krm.add_argument("site", help="站点名称")
    p_krm.add_argument("id", type=int, help="Key ID")
    p_krm.add_argument("--yes", action="store_true", help="确认删除 (破坏性操作)")

    # site
    p_site = subparsers.add_parser("site", help="站点配置管理")
    site_subs = p_site.add_subparsers(dest="subcommand")
    site_subs.add_parser("list", help="列出所有配置的站点")
    p_sauth = site_subs.add_parser("auth", help="录入长期系统访问令牌")
    p_sauth.add_argument("site", help="站点名称")
    p_srm = site_subs.add_parser("rm", help="删除站点配置")
    p_srm.add_argument("site", help="站点名称")
    p_srm.add_argument("--yes", action="store_true", help="确认删除")

    # web
    p_web = subparsers.add_parser("web", help="启动双端自适应 Web 管理控制台")
    p_web.add_argument("--host", default="0.0.0.0", help="监听地址 (默认 0.0.0.0)")
    p_web.add_argument("--port", type=int, default=8088, help="监听端口 (默认 8088)")

    args = parser.parse_args()
    if not args.command:
        parser.print_help()
        return EXIT_OK

    cfg = load_config()
    rc = EXIT_OK

    if args.command == "balance":
        rc = cmd_balance(args, cfg)
    elif args.command == "status":
        rc = cmd_status(args, cfg)
    elif args.command == "probe":
        rc = cmd_probe(args, cfg)
    elif args.command == "groups":
        rc = cmd_groups(args, cfg)
    elif args.command == "keys":
        rc = cmd_keys(args, cfg)
    elif args.command == "key":
        if args.subcommand == "add":
            rc = cmd_key_add(args, cfg)
        elif args.subcommand == "set":
            rc = cmd_key_set(args, cfg)
        elif args.subcommand == "rm":
            rc = cmd_key_rm(args, cfg)
        else:
            p_key.print_help()
    elif args.command == "web":
        from relayctl.web import run_web
        run_web(host=args.host, port=args.port)
        return EXIT_OK
    elif args.command == "site":
        if args.subcommand == "list":
            rc = cmd_site_list(args, cfg)
        elif args.subcommand == "auth":
            rc = cmd_site_auth(args, cfg)
        elif args.subcommand == "rm":
            rc = cmd_site_rm(args, cfg)
        else:
            p_site.print_help()

    sys.exit(rc)

if __name__ == "__main__":
    main()
